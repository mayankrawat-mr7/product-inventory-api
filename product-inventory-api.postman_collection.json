    {
      "name": "Price - Update (success)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns product, variant, oldPrice and newPrice', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body).to.have.property('product');",
              "  pm.expect(body).to.have.property('variant');",
              "  pm.expect(body).to.have.property('oldPrice');",
              "  pm.expect(body.newPrice).to.eql('1499.00');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"variantId\": \"{{variantId}}\",\n  \"price\": \"1499.00\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-price",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
