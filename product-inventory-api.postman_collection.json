    {
      "name": "Metafield - Create/Update (success)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns saved metafield', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.message).to.eql('Metafield saved successfully');",
              "  pm.expect(body.metafield.namespace).to.eql('custom');",
              "  pm.expect(body.metafield.key).to.eql('material');",
              "  pm.expect(body.metafield.value).to.eql('Cotton');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"namespace\": \"custom\",\n  \"key\": \"material\",\n  \"type\": \"single_line_text_field\",\n  \"value\": \"Cotton\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-metafield",
          "host": [
